[Unit]
Description=Webapp3 WhatsApp bot (Node)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/webapp3/whatsapp-bot
EnvironmentFile=/home/ubuntu/webapp3/deploy/.env
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
