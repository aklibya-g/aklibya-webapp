# متغيرات البيئة للإنتاج (انسخ هذا الملف إلى deploy/.env واملأ القيم)
# لا ترفع deploy/.env إلى git أبدًا

# --- Django ---
# ولّد مفتاحًا عشوائيًا طويلًا:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY

# كلمة مرور مستخدم قاعدة البيانات (استخدمها في DATABASE_URL أدناه)
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgres://webapp:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/webapp3

# --- بوت الواتساب ---
# عنوان Django العام (عنوان الخادم أو النطاق)، بدون شرطة مائلة في النهاية
DJANGO_URL=http://YOUR_SERVER_PUBLIC_IP
GROUP_JID=120363411662450255@g.us
MONITOR_ALL=1
SYNC_FULL_HISTORY=1
